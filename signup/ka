<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - Myraa</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;

            font-family: Arial, Helvetica, sans-serif;

            background: #77738b;

            color: white;
            padding: 30px;
        }

        /* MAIN CONTAINER */

        .container {
            width: 1250px;
            max-width: 100%;

            min-height: 760px;

            display: flex;

            padding: 18px;

            border-radius: 18px;

            background: #292436;

            box-shadow:
                0 30px 70px rgba(24, 18, 42, 0.45);
        }


        /* =========================
           LEFT IMAGE SECTION
        ========================= */

        .left-section {
            width: 51%;

            min-height: 725px;

            position: relative;

            overflow: hidden;

            border-radius: 12px;

            background:
                linear-gradient(
                    to bottom,
                    rgba(70, 44, 150, 0.15),
                    rgba(13, 8, 28, 0.75)
                ),
                url("background.jpg");

            background-size: cover;
            background-position: center;
        }


        /* Logo */

        .logo {
            position: absolute;

            top: 28px;
            left: 30px;

            font-size: 32px;

            font-weight: bold;

            letter-spacing: -4px;

            color: white;
        }


        /* Back button */

        .back-button {
            position: absolute;

            top: 24px;
            right: 25px;

            padding: 9px 16px;

            border-radius: 25px;

            color: white;

            background: rgba(255,255,255,0.15);

            backdrop-filter: blur(10px);

            font-size: 14px;

            text-decoration: none;

            transition: 0.3s;
        }

        .back-button:hover {
            background: rgba(255,255,255,0.25);
        }


        /* Image text */

        .image-text {
            position: absolute;

            left: 50px;
            bottom: 85px;
        }

        .image-text h2 {
            font-size: 32px;

            line-height: 1.2;

            font-weight: 400;
        }


        /* Slider */

        .slider {
            position: absolute;

            bottom: 32px;
            left: 50%;

            transform: translateX(-50%);

            display: flex;

            gap: 12px;
        }

        .slider span {
            width: 35px;
            height: 5px;

            border-radius: 5px;

            background: rgba(255,255,255,0.3);
        }

        .slider span.active {
            background: white;
        }


        /* =========================
           RIGHT SECTION
        ========================= */

        .right-section {
            width: 49%;

            padding: 65px 75px;

            display: flex;

            flex-direction: column;

            justify-content: center;
        }


        /* Heading */

        .right-section h1 {
            font-size: 48px;

            font-weight: 400;

            margin-bottom: 24px;

            color: white;
        }


        /* Login text */

        .login-text {
            color: #aaa5b5;

            font-size: 15px;

            margin-bottom: 50px;
        }

        .login-text a {
            color: #c2a7ff;

            text-decoration: underline;

            cursor: pointer;
        }


        /* Name fields */

        .name-row {
            display: flex;

            gap: 18px;

            margin-bottom: 20px;
        }

        .name-row input {
            width: 50%;
        }


        /* Inputs */

        input {
            width: 100%;

            height: 52px;

            border: none;

            outline: none;

            border-radius: 7px;

            padding: 0 20px;

            background: #403a50;

            color: white;

            font-size: 15px;

            transition: 0.3s;
        }

        input::placeholder {
            color: #858091;
        }

        input:focus {
            background: #48415a;

            box-shadow:
                0 0 0 1px #9a7bea;
        }


        /* Password */

        .password-box {
            position: relative;

            margin-top: 20px;
        }

        .password-box input {
            padding-right: 55px;
        }

        .eye {
            position: absolute;

            right: 18px;
            top: 50%;

            transform: translateY(-50%);

            color: #898397;

            cursor: pointer;

            font-size: 20px;
        }


        /* Terms */

        .terms {
            display: flex;

            align-items: center;

            gap: 12px;

            margin-top: 20px;

            color: #ddd9e3;

            font-size: 13px;
        }

        .terms input {
            width: 23px;
            height: 23px;

            accent-color: white;

            cursor: pointer;
        }

        .terms a {
            color: #b8a4eb;
        }


        /* Create button */

        .create-button {
            width: 100%;

            height: 52px;

            margin-top: 32px;

            border: none;

            border-radius: 6px;

            background: #7253c1;

            color: white;

            font-size: 15px;

            cursor: pointer;

            transition: 0.3s;
        }

        .create-button:hover {
            background: #8464d4;

            box-shadow:
                0 8px 25px rgba(114,83,193,0.3);
        }


        /* Divider */

        .divider {
            display: flex;

            align-items: center;

            gap: 18px;

            margin: 28px 0;

            color: #777180;

            font-size: 13px;
        }

        .divider::before,
        .divider::after {
            content: "";

            height: 1px;

            flex: 1;

            background: #55505f;
        }


        /* Social buttons */

        .social-row {
            display: flex;

            gap: 18px;
        }

        .social-button {
            width: 50%;

            height: 52px;

            border-radius: 6px;

            border: 1px solid #746d7f;

            background: transparent;

            color: white;

            font-size: 15px;

            cursor: pointer;

            transition: 0.3s;
        }

        .social-button:hover {
            background: rgba(255,255,255,0.06);

            border-color: #a995db;
        }


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 900px) {

            body {
                padding: 15px;
            }

            .container {
                flex-direction: column;

                padding: 12px;
            }

            .left-section {
                width: 100%;

                min-height: 350px;
            }

            .right-section {
                width: 100%;

                padding: 45px 30px;
            }

            .right-section h1 {
                font-size: 38px;
            }
        }


        @media (max-width: 500px) {

            .left-section {
                min-height: 280px;
            }

            .image-text {
                left: 25px;
                bottom: 55px;
            }

            .image-text h2 {
                font-size: 24px;
            }

            .right-section {
                padding: 35px 15px;
            }

            .right-section h1 {
                font-size: 32px;
            }

            .name-row {
                flex-direction: column;

                gap: 20px;
            }

            .name-row input {
                width: 100%;
            }

            .social-row {
                flex-direction: column;
            }

            .social-button {
                width: 100%;
            }
        }

    </style>
</head>


<body>


<div class="container">


    <!-- =========================
         LEFT SIDE
    ========================== -->

    <div class="left-section">

        <div class="logo">
            MYRAA
        </div>


        <a href="#" class="back-button">
            Back to website →
        </a>


        <div class="image-text">

            <h2>
                Capturing Moments,<br>
                Creating Memories
            </h2>

        </div>


        <div class="slider">

            <span></span>
            <span></span>
            <span class="active"></span>

        </div>

    </div>



    <!-- =========================
         RIGHT SIDE
    ========================== -->

    <div class="right-section">

        <h1>
            Create an account
        </h1>


        <p class="login-text">

            Already have an account?

            <a href="#">
                Log in
            </a>

        </p>


        <!-- FIRST + LAST NAME -->

        <div class="name-row">

            <input
                type="text"
                placeholder="First name"
                id="firstName"
            >

            <input
                type="text"
                placeholder="Last name"
                id="lastName"
            >

        </div>


        <!-- EMAIL -->

        <input
            type="email"
            placeholder="Email"
            id="email"
        >


        <!-- PASSWORD -->

        <div class="password-box">

            <input
                type="password"
                placeholder="Enter your password"
                id="password"
            >

            <span
                class="eye"
                onclick="togglePassword()"
            >
                👁
            </span>

        </div>


        <!-- TERMS -->

        <label class="terms">

            <input
                type="checkbox"
                id="terms"
            >

            <span>
                I agree to the
                <a href="#">
                    Terms & Conditions
                </a>
            </span>

        </label>


        <!-- CREATE ACCOUNT -->

        <button
            class="create-button"
            onclick="createAccount()"
        >
            Create account
        </button>


        <!-- DIVIDER -->

        <div class="divider">
            Or register with
        </div>


        <!-- SOCIAL -->

        <div class="social-row">

            <button class="social-button">
                <span style="color:#4285F4;font-weight:bold;">
                    G
                </span>
                &nbsp;
                Google
            </button>


            <button class="social-button">
                
                &nbsp;
                Apple
            </button>

        </div>

    </div>

</div>



<script>

    /* Show / Hide password */

    function togglePassword() {

        const password =
            document.getElementById("password");

        if (password.type === "password") {

            password.type = "text";

        } else {

            password.type = "password";

        }
    }


    /* Create account */

    function createAccount() {

        const firstName =
            document.getElementById("firstName").value.trim();

        const lastName =
            document.getElementById("lastName").value.trim();

        const email =
            document.getElementById("email").value.trim();

        const password =
            document.getElementById("password").value;

        const terms =
            document.getElementById("terms").checked;


        if (!firstName ||
            !lastName ||
            !email ||
            !password) {

            alert("Please fill in all fields.");

            return;
        }


        if (!terms) {

            alert(
                "Please accept the Terms & Conditions."
            );

            return;
        }


        alert(
            "Account creation successful!"
        );

        /*
            Connect your backend/Firebase
            authentication here.
        */
    }

</script>


</body>
