<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User Login</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            font-family: Arial, Helvetica, sans-serif;

            /* Background similar to your image */
            background: linear-gradient(
                180deg,
                #8fbaf0 0%,
                #aebbed 38%,
                #d5b7df 68%,
                #efb5d1 100%
            );

            color: #061b3d;
        }

        /* Login container */
        .login-container {
            width: 440px;
            max-width: 90%;

            text-align: center;
        }

        /* Top line */
        .top-line {
            width: 100%;
            height: 1px;

            background: rgba(255, 255, 255, 0.9);

            margin-bottom: 38px;
        }

        /* Heading */
        .login-title {
            font-size: 36px;
            font-weight: 300;

            letter-spacing: 5px;

            margin-bottom: 42px;

            color: #071a3d;
        }

        /* Input area */
        .input-box {
            position: relative;

            width: 100%;

            margin-bottom: 32px;
        }

        /* Icons */
        .input-icon {
            position: absolute;

            left: 0;
            top: 50%;

            transform: translateY(-50%);

            width: 40px;

            font-size: 20px;

            color: #061e48;
        }

        /* Inputs */
        .input-box input {
            width: 100%;

            height: 45px;

            padding: 0 10px 0 56px;

            border: none;
            border-bottom: 1px solid #071a3d;

            outline: none;

            background: transparent;

            font-size: 16px;

            color: #071a3d;
        }

        .input-box input::placeholder {
            color: #66708e;

            opacity: 1;
        }

        .input-box input:focus {
            border-bottom: 2px solid #061e48;
        }

        /* Options */
        .options {
            display: flex;

            justify-content: space-between;
            align-items: center;

            margin: -6px 40px 28px 48px;

            font-size: 13px;

            color: #384465;
        }

        /* Remember me */
        .remember {
            display: flex;
            align-items: center;

            gap: 7px;

            cursor: pointer;
        }

        .remember input {
            width: 14px;
            height: 14px;

            accent-color: #163f6c;

            cursor: pointer;
        }

        /* Forgot password */
        .forgot {
            font-style: italic;

            cursor: pointer;

            transition: 0.2s;
        }

        .forgot:hover {
            color: #071a3d;
        }

        /* Login button */
        .login-button {
            width: 310px;
            max-width: 100%;

            height: 51px;

            border: 1px solid #041b3c;

            background: #062b53;

            color: white;

            font-size: 14px;

            font-weight: bold;

            letter-spacing: 2px;

            cursor: pointer;

            transition: 0.3s;
        }

        .login-button:hover {
            background: #0a3d70;

            box-shadow:
                0 8px 20px rgba(5, 38, 78, 0.25);

            transform: translateY(-1px);
        }

        .login-button:active {
            transform: translateY(0);
        }

        /* Bottom line */
        .bottom-line {
            width: 100%;
            height: 1px;

            background: rgba(255, 255, 255, 0.9);

            margin-top: 70px;
        }


        /* -------------------------
           MOBILE
        ------------------------- */

        @media (max-width: 600px) {

            .login-container {
                width: 85%;
            }

            .login-title {
                font-size: 30px;
                letter-spacing: 4px;
            }

            .options {
                margin-left: 45px;
                margin-right: 20px;
            }

            .bottom-line {
                margin-top: 55px;
            }
        }

    </style>
</head>


<body>

    <div class="login-container">

        <!-- TOP LINE -->
        <div class="top-line"></div>


        <!-- TITLE -->
        <h1 class="login-title">
            User Login
        </h1>


        <!-- EMAIL -->
        <div class="input-box">

            <span class="input-icon">
                ✉
            </span>

            <input
                type="email"
                id="email"
                placeholder="Email ID"
                autocomplete="email"
            >

        </div>


        <!-- PASSWORD -->
        <div class="input-box">

            <span class="input-icon">
                🔒
            </span>

            <input
                type="password"
                id="password"
                placeholder="Password"
                autocomplete="current-password"
            >

        </div>


        <!-- OPTIONS -->
        <div class="options">

            <label class="remember">

                <input
                    type="checkbox"
                    id="remember"
                >

                <span>
                    Remember me
                </span>

            </label>


            <span class="forgot">
                Forgot Password?
            </span>

        </div>


        <!-- LOGIN BUTTON -->
        <button
            class="login-button"
            onclick="login()"
        >
            LOGIN
        </button>


        <!-- BOTTOM LINE -->
        <div class="bottom-line"></div>

    </div>


    <script>

        function login() {

            const email =
                document.getElementById("email").value.trim();

            const password =
                document.getElementById("password").value;

            if (email === "") {

                alert("Please enter your Email ID.");

                return;
            }

            if (password === "") {

                alert("Please enter your Password.");

                return;
            }

            // Add your backend authentication here
            alert("Login successful!");

        }

    </script>

</body>
